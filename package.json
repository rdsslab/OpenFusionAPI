{
	"name": "openfusionapi",
	"version": "13.0.0",
	"scripts": {
		"dev": "vite dev",
		"build": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"start": "node ./server/index.js",
		"build_start": "node --max-old-space-size=6144 ./node_modules/vite/bin/vite.js build && node ./server/index.js",
		"reinstall": "rm -rf node_modules && rm package-lock.json && npm install && npm run build"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/fira-mono": "^5.3.0",
		"@neoconfetti/svelte": "^2.2.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"type": "module",
	"overrides": {
		"@azure/identity": "^4.2.1",
		"@xmldom/xmldom": "^0.9.8",
		"minimatch": "^10.2.1",
		"tar": "^7.5.8"
	},
	"dependencies": {
		"@rdsslab/libopenfusionapi": "https://github.com/rdsslab/libOpenFusionAPI.git",
		"@rdsslab/libopenfusionapigui": "https://github.com/rdsslab/libOpenFusionAPIGUI.git",
		"cookie": "^0.6.0",
		"jsonwebtoken": "^9.0.3"
	}
}
